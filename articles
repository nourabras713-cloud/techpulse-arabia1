<style>
:root{
  --bg:#06060e;--bg2:#0b0b16;--bg3:#0f0f1c;--card:#111120;--card2:#16162a;
  --accent:#00e5ff;--accent2:#ff4d6d;--accent3:#7b2fff;
  --text:#eeeef5;--text2:#8888aa;--text3:#44445a;
  --border:#1e1e36;--border2:#2a2a48;
  --font-ar:'Cairo','Tajawal',sans-serif;--font-mono:'IBM Plex Mono',monospace;
  --r:16px;--shadow:0 8px 40px rgba(0,0,0,.6);--glow:0 0 60px rgba(0,229,255,.12);
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--text);font-family:var(--font-ar);line-height:1.75;overflow-x:hidden;}
::-webkit-scrollbar{width:3px;}::-webkit-scrollbar-track{background:var(--bg);}::-webkit-scrollbar-thumb{background:var(--accent);border-radius:2px;}
.bg-grid{position:fixed;inset:0;pointer-events:none;z-index:0;background-image:linear-gradient(rgba(0,229,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(0,229,255,.025) 1px,transparent 1px);background-size:72px 72px;}
.bg-orb{position:fixed;pointer-events:none;z-index:0;border-radius:50%;filter:blur(100px);}
.bg-orb1{width:500px;height:500px;background:rgba(0,229,255,.04);top:-150px;right:-150px;}
.bg-orb2{width:400px;height:400px;background:rgba(123,47,255,.04);bottom:-150px;left:-150px;}

/* NAV */
nav{position:fixed;top:0;width:100%;z-index:1000;padding:0 2rem;background:rgba(6,6,14,.82);backdrop-filter:blur(24px);border-bottom:1px solid var(–border);}
.nav-inner{max-width:1360px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;height:68px;}
.logo{display:flex;align-items:center;gap:.8rem;text-decoration:none;}
.logo-mark{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,var(–accent),var(–accent3));display:flex;align-items:center;justify-content:center;font-family:var(–font-mono);font-weight:700;font-size:.95rem;color:#000;box-shadow:0 0 20px rgba(0,229,255,.35);}
.logo-text{line-height:1.15;}
.logo-en{font-family:var(–font-mono);font-size:.95rem;font-weight:700;color:var(–accent);}
.logo-ar{font-size:.68rem;color:var(–text3);font-weight:300;}
.nav-links{display:flex;gap:.1rem;list-style:none;}
.nav-links a{display:block;padding:.45rem .9rem;color:var(–text2);text-decoration:none;font-size:.88rem;border-radius:8px;transition:all .2s;font-weight:500;}
.nav-links a:hover,.nav-links a.active{color:var(–accent);background:rgba(0,229,255,.07);}
.nav-actions{display:flex;align-items:center;gap:.6rem;}
.btn-icon{width:38px;height:38px;border:1px solid var(–border);border-radius:9px;background:transparent;color:var(–text2);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;font-size:.95rem;text-decoration:none;}
.btn-icon:hover{border-color:var(–accent);color:var(–accent);}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:5px;}
.hamburger span{width:22px;height:2px;background:var(–text2);border-radius:2px;transition:all .3s;}
.mobile-nav{display:none;flex-direction:column;position:absolute;top:68px;left:0;right:0;background:var(–bg2);border-bottom:1px solid var(–border);padding:1rem 2rem;z-index:999;}
.mobile-nav a{display:block;padding:.6rem 0;color:var(–text2);text-decoration:none;font-size:.92rem;border-bottom:1px solid var(–border);transition:color .2s;}
.mobile-nav a:last-child{border-bottom:none;}
.mobile-nav a:hover{color:var(–accent);}

/* PAGE HERO */
.page-hero{padding:120px 2rem 3rem;text-align:center;position:relative;z-index:1;}
.page-hero h1{font-size:clamp(2rem,4vw,3rem);font-weight:900;margin-bottom:.75rem;}
.page-hero h1 span{background:linear-gradient(120deg,var(–accent),var(–accent3));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.page-hero p{color:var(–text2);font-size:1rem;font-weight:300;max-width:500px;margin:0 auto;}

/* CONTAINER */
.container{max-width:1360px;margin:0 auto;padding:0 2rem;}
section{position:relative;z-index:1;}

/* AD */
.ad-wrap{padding:1.2rem 0;position:relative;z-index:1;}
.ad-unit{background:var(–bg2);border:1px dashed var(–border2);border-radius:var(–r);display:flex;align-items:center;justify-content:center;color:var(–text3);font-size:.75rem;font-family:var(–font-mono);text-align:center;padding:1rem;}
.ad-banner{min-height:90px;width:100%;}
.ad-square{min-height:250px;width:100%;}
.ad-unit small{display:block;font-size:.62rem;margin-bottom:.3rem;}

/* FILTERS */
.filters-bar{
display:flex;align-items:center;justify-content:space-between;
padding:1.5rem 0;flex-wrap:wrap;gap:1rem;
position:relative;z-index:1;
}
.filter-tabs{display:flex;gap:.5rem;flex-wrap:wrap;}
.filter-tab{
padding:.4rem 1rem;border:1px solid var(–border);border-radius:50px;
font-size:.82rem;color:var(–text2);cursor:pointer;transition:all .2s;
background:transparent;font-family:var(–font-ar);
}
.filter-tab:hover,.filter-tab.active{
border-color:var(–accent);color:var(–accent);
background:rgba(0,229,255,.06);
}
.sort-select{
padding:.4rem .9rem;border:1px solid var(–border);border-radius:8px;
background:var(–card);color:var(–text2);font-family:var(–font-ar);
font-size:.82rem;outline:none;cursor:pointer;
}

/* MAIN GRID */
.articles-main{display:grid;grid-template-columns:1fr 300px;gap:2rem;padding-bottom:4rem;}
.articles-list{display:flex;flex-direction:column;gap:1rem;}

/* ARTICLE CARD HORIZONTAL */
.art-card{
background:var(–card);border:1px solid var(–border);border-radius:var(–r);
display:flex;gap:0;overflow:hidden;
text-decoration:none;color:inherit;transition:all .3s;cursor:pointer;
}
.art-card:hover{border-color:rgba(0,229,255,.28);transform:translateX(-3px);box-shadow:var(–shadow);}
.art-thumb{
width:200px;min-height:155px;flex-shrink:0;
background:linear-gradient(135deg,#0a0a20,#12123a,#080820);
display:flex;align-items:center;justify-content:center;
font-size:3rem;position:relative;
}
.art-thumb-sm{width:140px;}
.art-body{padding:1.3rem;flex:1;display:flex;flex-direction:column;}
.art-cat{
font-size:.68rem;font-family:var(–font-mono);font-weight:700;
padding:.22rem .6rem;border-radius:5px;
display:inline-block;margin-bottom:.6rem;
}
.c-ai{background:rgba(123,47,255,.9);color:#ddd0ff;}
.c-web{background:rgba(0,229,255,.9);color:#000;}
.c-mob{background:rgba(255,77,109,.9);color:#fff;}
.c-sec{background:rgba(239,68,68,.9);color:#fff;}
.c-tools{background:rgba(34,197,94,.9);color:#000;}
.c-cloud{background:rgba(56,189,248,.9);color:#000;}
.art-title{font-size:1.05rem;font-weight:700;line-height:1.4;margin-bottom:.5rem;}
.art-excerpt{font-size:.85rem;color:var(–text2);line-height:1.6;flex:1;font-weight:300;}
.art-foot{display:flex;align-items:center;justify-content:space-between;margin-top:.9rem;padding-top:.8rem;border-top:1px solid var(–border);}
.author{display:flex;align-items:center;gap:.5rem;}
.ava{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,var(–accent),var(–accent3));display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:700;color:#000;}
.author-name{font-size:.75rem;color:var(–text2);}
.art-meta-r{display:flex;gap:.8rem;font-size:.72rem;color:var(–text3);font-family:var(–font-mono);}

/* FEATURED ARTICLE (big) */
.art-card-big{
background:var(–card);border:1px solid var(–border);border-radius:var(–r);
overflow:hidden;text-decoration:none;color:inherit;transition:all .3s;cursor:pointer;
}
.art-card-big:hover{border-color:rgba(0,229,255,.28);transform:translateY(-3px);box-shadow:var(–shadow),var(–glow);}
.big-thumb{
height:280px;background:linear-gradient(135deg,#0a0a20,#12123a,#080820);
display:flex;align-items:center;justify-content:center;font-size:4rem;
position:relative;overflow:hidden;
}
.big-thumb::after{content:’’;position:absolute;inset:0;background:linear-gradient(to bottom,transparent 50%,rgba(17,17,32,.9) 100%);}
.big-body{padding:1.6rem;}
.big-title{font-size:1.3rem;font-weight:800;line-height:1.4;margin-bottom:.75rem;}
.big-excerpt{font-size:.9rem;color:var(–text2);line-height:1.65;font-weight:300;margin-bottom:1rem;}
.big-foot{display:flex;align-items:center;justify-content:space-between;padding-top:1rem;border-top:1px solid var(–border);}

/* SIDEBAR */
.sidebar{display:flex;flex-direction:column;gap:1.5rem;}
.widget{background:var(–card);border:1px solid var(–border);border-radius:14px;padding:1.4rem;}
.widget-title{font-size:.88rem;font-weight:700;margin-bottom:1.2rem;display:flex;align-items:center;gap:.5rem;}
.widget-title::before{content:’’;width:3px;height:15px;background:var(–accent);border-radius:2px;}
.trend-list{display:flex;flex-direction:column;gap:.7rem;}
.trend-item{display:flex;align-items:flex-start;gap:.7rem;padding-bottom:.7rem;border-bottom:1px solid var(–border);cursor:pointer;text-decoration:none;color:inherit;transition:color .2s;}
.trend-item:last-child{border-bottom:none;padding-bottom:0;}
.trend-item:hover .t-ti{color:var(–accent);}
.t-n{font-family:var(–font-mono);font-size:1.1rem;font-weight:700;color:var(–border2);line-height:1;min-width:22px;}
.t-ti{font-size:.83rem;line-height:1.4;font-weight:500;}
.t-m{font-size:.7rem;color:var(–text3);font-family:var(–font-mono);margin-top:.2rem;}
.newsletter-w{background:linear-gradient(135deg,rgba(0,229,255,.07),rgba(123,47,255,.07));border-color:rgba(0,229,255,.18);}
.newsletter-w p{font-size:.83rem;color:var(–text2);margin-bottom:.9rem;font-weight:300;}
.inp-group{display:flex;flex-direction:column;gap:.45rem;}
.inp-group input{width:100%;padding:.65rem .9rem;background:var(–bg);border:1px solid var(–border);border-radius:8px;color:var(–text);font-family:var(–font-ar);font-size:.88rem;outline:none;transition:border-color .2s;text-align:right;}
.inp-group input:focus{border-color:var(–accent);}
.inp-group button{padding:.65rem;background:linear-gradient(135deg,var(–accent),#007acc);border:none;border-radius:8px;color:#000;font-family:var(–font-ar);font-weight:700;cursor:pointer;transition:opacity .2s;}
.inp-group button:hover{opacity:.85;}
.tags-cloud{display:flex;flex-wrap:wrap;gap:.45rem;}
.tag-pill{padding:.28rem .7rem;border:1px solid var(–border);border-radius:50px;font-size:.73rem;color:var(–text2);cursor:pointer;transition:all .2s;text-decoration:none;}
.tag-pill:hover{border-color:var(–accent);color:var(–accent);background:rgba(0,229,255,.05);}

/* TUTORIALS SECTION */
.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;}
.section-label{display:flex;align-items:center;gap:.75rem;}
.section-label h2{font-size:1.5rem;font-weight:700;}
.tag-badge{font-family:var(–font-mono);font-size:.68rem;padding:.2rem .6rem;border:1px solid var(–accent);border-radius:5px;color:var(–accent);}
.link-all{font-size:.82rem;color:var(–accent);text-decoration:none;font-family:var(–font-mono);border-bottom:1px solid transparent;transition:border-color .2s;}
.link-all:hover{border-color:var(–accent);}
.tuts-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem;margin-bottom:4rem;}
.tut-card{background:var(–card);border:1px solid var(–border);border-radius:14px;padding:1.5rem;cursor:pointer;transition:all .3s;position:relative;overflow:hidden;text-decoration:none;color:inherit;}
.tut-card::before{content:’’;position:absolute;top:-30px;right:-30px;width:100px;height:100px;border-radius:50%;background:radial-gradient(circle,rgba(0,229,255,.08),transparent);}
.tut-card:hover{border-color:rgba(0,229,255,.28);transform:translateY(-3px);box-shadow:var(–shadow);}
.tut-level{font-size:.68rem;font-family:var(–font-mono);padding:.2rem .6rem;border-radius:4px;margin-bottom:1rem;display:inline-block;}
.lv-b{background:rgba(34,197,94,.12);color:#4ade80;border:1px solid rgba(34,197,94,.25);}
.lv-m{background:rgba(251,191,36,.12);color:#fbbf24;border:1px solid rgba(251,191,36,.25);}
.lv-a{background:rgba(239,68,68,.12);color:#f87171;border:1px solid rgba(239,68,68,.25);}
.tut-ico{font-size:2rem;margin-bottom:.7rem;display:block;}
.tut-title{font-size:1rem;font-weight:700;margin-bottom:.45rem;}
.tut-desc{font-size:.83rem;color:var(–text2);line-height:1.55;font-weight:300;}
.tut-foot{display:flex;justify-content:space-between;margin-top:1.2rem;padding-top:1rem;border-top:1px solid var(–border);font-size:.72rem;color:var(–text3);font-family:var(–font-mono);}

/* LOAD MORE */
.load-more-wrap{text-align:center;padding:2rem 0;}
.btn-load{
padding:.8rem 2.5rem;background:transparent;
border:1px solid var(–border2);border-radius:10px;
color:var(–text2);font-family:var(–font-ar);font-size:.95rem;
cursor:pointer;transition:all .3s;
}
.btn-load:hover{border-color:var(–accent);color:var(–accent);}

/* SEARCH OVERLAY */
.search-overlay{position:fixed;inset:0;background:rgba(6,6,14,.97);z-index:2000;display:flex;align-items:flex-start;justify-content:center;padding-top:15vh;opacity:0;pointer-events:none;transition:opacity .3s;}
.search-overlay.open{opacity:1;pointer-events:all;}
.search-box{width:100%;max-width:680px;padding:0 2rem;}
.search-wrap{display:flex;align-items:center;background:var(–card);border:1px solid var(–border2);border-radius:14px;padding:.9rem 1.4rem;gap:1rem;}
.search-wrap:focus-within{border-color:var(–accent);}
#s-input{flex:1;background:transparent;border:none;color:var(–text);font-family:var(–font-ar);font-size:1.15rem;outline:none;text-align:right;}
.s-hint{font-family:var(–font-mono);font-size:.73rem;color:var(–text3);margin-top:.9rem;text-align:center;}

/* FOOTER */
footer{background:var(–bg2);border-top:1px solid var(–border);padding:4rem 0 2rem;margin-top:2rem;position:relative;z-index:1;}
.footer-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:3rem;margin-bottom:3rem;}
.f-brand p{font-size:.85rem;color:var(–text2);margin:1rem 0 1.4rem;font-weight:300;line-height:1.75;}
.social-row{display:flex;gap:.65rem;}
.f-col h4{font-size:.88rem;font-weight:700;margin-bottom:1.2rem;color:var(–text);}
.f-links{list-style:none;display:flex;flex-direction:column;gap:.55rem;}
.f-links a{font-size:.83rem;color:var(–text2);text-decoration:none;transition:color .2s;font-weight:300;}
.f-links a:hover{color:var(–accent);}
.footer-bottom{padding-top:2rem;border-top:1px solid var(–border);display:flex;justify-content:space-between;align-items:center;font-size:.78rem;color:var(–text3);font-family:var(–font-mono);}

/* ANIMATIONS */
@keyframes fadeUp{from{opacity:0;transform:translateY(22px);}to{opacity:1;transform:translateY(0);}}
.fade-up{opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s ease;}
.fade-up.visible{opacity:1;transform:translateY(0);}

/* RESPONSIVE */
@media(max-width:1100px){
.articles-main{grid-template-columns:1fr;}
.tuts-grid{grid-template-columns:repeat(2,1fr);}
.footer-grid{grid-template-columns:1fr 1fr;}
}
@media(max-width:768px){
.nav-links{display:none;}.hamburger{display:flex;}
.art-card{flex-direction:column;}.art-thumb{width:100%;min-height:130px;}
.tuts-grid{grid-template-columns:1fr;}
.footer-grid{grid-template-columns:1fr;gap:2rem;}
.footer-bottom{flex-direction:column;gap:.8rem;text-align:center;}
.filter-tabs{gap:.35rem;}
}
</style>

</head>
