<script>
function openSearch(){document.getElementById('searchOverlay').classList.add('open');document.getElementById('s-input').focus();}
function closeSearch(){document.getElementById('searchOverlay').classList.remove('open');}
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeSearch();});
document.getElementById('searchOverlay').addEventListener('click',function(e){if(e.target===this)closeSearch();});
function toggleMenu(){const m=document.getElementById('mobileNav');m.style.display=m.style.display==='flex'?'none':'flex';}

function filterTools(btn,cat){
  if(btn){document.querySelectorAll('.filter-tab').forEach(b=>b.classList.remove('active'));btn.classList.add('active');}
  document.querySelectorAll('#toolsGrid > [data-cat]').forEach(card=>{
    if(card.dataset.cat==='ad'){card.style.display='flex';return;}
    card.style.display=(cat==='all'||card.dataset.cat===cat)?'flex':'none';
  });
  checkNoResults();
}

function searchTools(val){
  const v=val.toLowerCase().trim();
  document.querySelectorAll('#toolsGrid > [data-cat]').forEach(card=>{
    if(card.dataset.cat==='ad'){card.style.display=v?'none':'flex';return;}
    const name=(card.dataset.name||'').toLowerCase();
    card.style.display=(!v||name.includes(v))?'flex':'none';
  });
  document.querySelectorAll('.filter-tab').forEach(b=>b.classList.remove('active'));
  if(!v)document.querySelector('.filter-tab').classList.add('active');
  checkNoResults();
}

function checkNoResults(){
  const visible=[...document.querySelectorAll('#toolsGrid > [data-cat]:not([data-cat="ad"])')].filter(c=>c.style.display!=='none');
  document.getElementById('noResults').style.display=visible.length===0?'block':'none';
}

const obs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');obs.unobserve(e.target);}});
},{threshold:0.08});
document.querySelectorAll('.fade-up').forEach(el=>obs.observe(el));

document.querySelectorAll('.tool-card').forEach(card=>{
  card.addEventListener('mousemove',e=>{
    const r=card.getBoundingClientRect();
    const x=((e.clientX-r.left)/r.width)*100,y=((e.clientY-r.top)/r.height)*100;
    if(!card.classList.contains('featured'))
      card.style.background=`radial-gradient(circle at ${x}% ${y}%,#181830 0%,#111120 100%)`;
  });
  card.addEventListener('mouseleave',()=>{if(!card.classList.contains('featured'))card.style.background='';});
});
</script>

