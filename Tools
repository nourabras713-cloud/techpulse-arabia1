<style>
:root{
  --bg:#06060e;--bg2:#0b0b16;--bg3:#0f0f1c;--card:#111120;--card2:#16162a;
  --accent:#00e5ff;--accent2:#ff4d6d;--accent3:#7b2fff;--gold:#f5c518;
  --text:#eeeef5;--text2:#8888aa;--text3:#44445a;
  --border:#1e1e36;--border2:#2a2a48;
  --font-ar:'Cairo','Tajawal',sans-serif;--font-mono:'IBM Plex Mono',monospace;
  --r:16px;--shadow:0 8px 40px rgba(0,0,0,.6);--glow:0 0 60px rgba(0,229,255,.12);
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{background:var(--bg);color:var(--text);font-family:var(--font-ar);line-height:1.75;overflow-x:hidden;}
::-webkit-scrollbar{width:3px;}::-webkit-scrollbar-track{background:var(--bg);}::-webkit-scrollbar-thumb{background:var(--accent);border-radius:2px;}
.bg-grid{position:fixed;inset:0;pointer-events:none;z-index:0;background-image:linear-gradient(rgba(0,229,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(0,229,255,.025) 1px,transparent 1px);background-size:72px 72px;}
.bg-orb{position:fixed;pointer-events:none;z-index:0;border-radius:50%;filter:blur(100px);}
.bg-orb1{width:500px;height:500px;background:rgba(0,229,255,.04);top:-150px;right:-150px;}
.bg-orb2{width:400px;height:400px;background:rgba(123,47,255,.04);bottom:-150px;left:-150px;}

/* NAV */
nav{position:fixed;top:0;width:100%;z-index:1000;padding:0 2rem;background:rgba(6,6,14,.82);backdrop-filter:blur(24px);border-bottom:1px solid var(–border);}
.nav-inner{max-width:1360px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;height:68px;}
.logo{display:flex;align-items:center;gap:.8rem;text-decoration:none;}
.logo-mark{width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,var(–accent),var(–accent3));display:flex;align-items:center;justify-content:center;font-family:var(–font-mono);font-weight:700;font-size:.95rem;color:#000;box-shadow:0 0 20px rgba(0,229,255,.35);}
.logo-text{line-height:1.15;}
.logo-en{font-family:var(–font-mono);font-size:.95rem;font-weight:700;color:var(–accent);}
.logo-ar{font-size:.68rem;color:var(–text3);font-weight:300;}
.nav-links{display:flex;gap:.1rem;list-style:none;}
.nav-links a{display:block;padding:.45rem .9rem;color:var(–text2);text-decoration:none;font-size:.88rem;border-radius:8px;transition:all .2s;font-weight:500;}
.nav-links a:hover,.nav-links a.active{color:var(–accent);background:rgba(0,229,255,.07);}
.nav-actions{display:flex;align-items:center;gap:.6rem;}
.btn-icon{width:38px;height:38px;border:1px solid var(–border);border-radius:9px;background:transparent;color:var(–text2);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;font-size:.95rem;text-decoration:none;}
.btn-icon:hover{border-color:var(–accent);color:var(–accent);}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:5px;}
.hamburger span{width:22px;height:2px;background:var(–text2);border-radius:2px;}
.mobile-nav{display:none;flex-direction:column;position:absolute;top:68px;left:0;right:0;background:var(–bg2);border-bottom:1px solid var(–border);padding:1rem 2rem;z-index:999;}
.mobile-nav a{display:block;padding:.6rem 0;color:var(–text2);text-decoration:none;font-size:.92rem;border-bottom:1px solid var(–border);transition:color .2s;}
.mobile-nav a:last-child{border-bottom:none;}
.mobile-nav a:hover{color:var(–accent);}

/* PAGE HERO */
.page-hero{padding:120px 2rem 3rem;text-align:center;position:relative;z-index:1;}
.page-hero h1{font-size:clamp(2rem,4vw,3rem);font-weight:900;margin-bottom:.75rem;}
.page-hero h1 span{background:linear-gradient(120deg,var(–accent),var(–accent3));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.page-hero p{color:var(–text2);font-size:1rem;font-weight:300;max-width:520px;margin:0 auto 1.5rem;}
.hero-stats-sm{display:flex;gap:2rem;justify-content:center;flex-wrap:wrap;}
.stat-sm{text-align:center;}
.stat-sm-n{font-family:var(–font-mono);font-size:1.4rem;font-weight:700;color:var(–accent);display:block;}
.stat-sm-l{font-size:.75rem;color:var(–text3);}

/* CONTAINER */
.container{max-width:1360px;margin:0 auto;padding:0 2rem;}
section{position:relative;z-index:1;}

/* AD */
.ad-wrap{padding:1.2rem 0;position:relative;z-index:1;}
.ad-unit{background:var(–bg2);border:1px dashed var(–border2);border-radius:var(–r);display:flex;align-items:center;justify-content:center;color:var(–text3);font-size:.75rem;font-family:var(–font-mono);text-align:center;padding:1rem;}
.ad-banner{min-height:90px;width:100%;}
.ad-square{min-height:250px;width:100%;}
.ad-unit small{display:block;font-size:.62rem;margin-bottom:.3rem;}

/* SEARCH BAR */
.tools-search{
max-width:600px;margin:0 auto 2.5rem;
position:relative;z-index:1;
}
.tools-search-wrap{
display:flex;align-items:center;
background:var(–card);border:1px solid var(–border2);
border-radius:12px;padding:.75rem 1.2rem;gap:.8rem;
}
.tools-search-wrap:focus-within{border-color:var(–accent);}
.tools-search-wrap input{
flex:1;background:transparent;border:none;color:var(–text);
font-family:var(–font-ar);font-size:1rem;outline:none;text-align:right;
}

/* FILTER TABS */
.filters-bar{
display:flex;align-items:center;justify-content:center;
padding:0 0 2rem;flex-wrap:wrap;gap:.5rem;
position:relative;z-index:1;
}
.filter-tab{
padding:.4rem 1rem;border:1px solid var(–border);border-radius:50px;
font-size:.82rem;color:var(–text2);cursor:pointer;transition:all .2s;
background:transparent;font-family:var(–font-ar);
}
.filter-tab:hover,.filter-tab.active{
border-color:var(–accent);color:var(–accent);
background:rgba(0,229,255,.06);
}

/* TOOLS GRID */
.tools-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:1.25rem;
margin-bottom:2rem;
position:relative;z-index:1;
}

/* TOOL CARD */
.tool-card{
background:var(–card);border:1px solid var(–border);
border-radius:var(–r);padding:1.5rem;
cursor:pointer;transition:all .3s;
text-decoration:none;color:inherit;
display:flex;flex-direction:column;position:relative;overflow:hidden;
}
.tool-card::before{
content:’’;position:absolute;top:0;right:0;
width:120px;height:120px;
background:radial-gradient(circle,rgba(0,229,255,.06),transparent);
pointer-events:none;
}
.tool-card:hover{
border-color:rgba(0,229,255,.3);
transform:translateY(-4px);
box-shadow:var(–shadow),var(–glow);
}
.tool-card.featured{
border-color:rgba(245,197,24,.25);
background:linear-gradient(135deg,#111120,#16140a);
}
.tool-card.featured::before{background:radial-gradient(circle,rgba(245,197,24,.06),transparent);}
.tool-card.featured:hover{border-color:rgba(245,197,24,.5);box-shadow:0 0 40px rgba(245,197,24,.1);}

.tool-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:1rem;}
.tool-icon{
width:52px;height:52px;border-radius:13px;
display:flex;align-items:center;justify-content:center;
font-size:1.6rem;flex-shrink:0;
background:linear-gradient(135deg,#0f0f22,#1a1a3a);
}
.tool-badges{display:flex;flex-direction:column;align-items:flex-end;gap:.35rem;}
.badge{font-size:.65rem;font-family:var(–font-mono);padding:.2rem .55rem;border-radius:50px;font-weight:700;}
.badge-free{background:rgba(34,197,94,.15);color:#4ade80;border:1px solid rgba(34,197,94,.25);}
.badge-paid{background:rgba(239,68,68,.15);color:#f87171;border:1px solid rgba(239,68,68,.25);}
.badge-freemium{background:rgba(251,191,36,.15);color:#fbbf24;border:1px solid rgba(251,191,36,.25);}
.badge-hot{background:rgba(255,77,109,.15);color:#ff4d6d;border:1px solid rgba(255,77,109,.25);}
.badge-new{background:rgba(0,229,255,.15);color:var(–accent);border:1px solid rgba(0,229,255,.25);}
.badge-gold{background:rgba(245,197,24,.15);color:var(–gold);border:1px solid rgba(245,197,24,.25);}

.tool-name{font-size:1.05rem;font-weight:700;margin-bottom:.4rem;}
.tool-cat-tag{
font-size:.68rem;font-family:var(–font-mono);
padding:.18rem .55rem;border-radius:4px;
display:inline-block;margin-bottom:.65rem;
}
.c-ai{background:rgba(123,47,255,.9);color:#ddd0ff;}
.c-web{background:rgba(0,229,255,.9);color:#000;}
.c-design{background:rgba(255,77,109,.9);color:#fff;}
.c-code{background:rgba(34,197,94,.9);color:#000;}
.c-prod{background:rgba(251,191,36,.9);color:#000;}
.c-write{background:rgba(56,189,248,.9);color:#000;}
.c-data{background:rgba(168,85,247,.9);color:#fff;}
.c-seo{background:rgba(249,115,22,.9);color:#fff;}

.tool-desc{font-size:.84rem;color:var(–text2);line-height:1.6;flex:1;font-weight:300;}
.tool-footer{
display:flex;align-items:center;justify-content:space-between;
margin-top:1.2rem;padding-top:1rem;border-top:1px solid var(–border);
}
.tool-rating{display:flex;align-items:center;gap:.3rem;font-size:.82rem;color:var(–gold);}
.tool-users{font-size:.72rem;color:var(–text3);font-family:var(–font-mono);}
.tool-link{
font-size:.75rem;color:var(–accent);font-family:var(–font-mono);
display:flex;align-items:center;gap:.3rem;
text-decoration:none;transition:opacity .2s;
}
.tool-link:hover{opacity:.75;}

/* FEATURED TOOL (wide) */
.tool-card-wide{
grid-column:span 2;
display:grid;grid-template-columns:1fr auto;
gap:1.5rem;align-items:center;
}
.tool-wide-left{display:flex;flex-direction:column;}
.tool-wide-right{
display:flex;flex-direction:column;gap:.65rem;
align-items:flex-end;min-width:160px;
}
.btn-try{
padding:.6rem 1.4rem;
background:linear-gradient(135deg,var(–accent),#007acc);
color:#000;border:none;border-radius:8px;
font-family:var(–font-ar);font-weight:700;font-size:.85rem;
cursor:pointer;text-decoration:none;transition:all .3s;
display:inline-flex;align-items:center;gap:.4rem;
box-shadow:0 0 20px rgba(0,229,255,.25);
}
.btn-try:hover{transform:translateY(-1px);box-shadow:0 0 30px rgba(0,229,255,.4);}
.btn-try-outline{
padding:.6rem 1.4rem;background:transparent;
color:var(–text2);border:1px solid var(–border2);
border-radius:8px;font-family:var(–font-ar);font-size:.85rem;
cursor:pointer;text-decoration:none;transition:all .3s;
display:inline-flex;align-items:center;gap:.4rem;
}
.btn-try-outline:hover{border-color:var(–accent);color:var(–accent);}

/* SECTION HEAD */
.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;position:relative;z-index:1;}
.section-label{display:flex;align-items:center;gap:.75rem;}
.section-label h2{font-size:1.5rem;font-weight:700;}
.tag-badge{font-family:var(–font-mono);font-size:.68rem;padding:.2rem .6rem;border:1px solid var(–accent);border-radius:5px;color:var(–accent);}
.section-pad{padding:5rem 0 2rem;}

/* COMPARISON TABLE */
.compare-table{
background:var(–card);border:1px solid var(–border);
border-radius:var(–r);overflow:hidden;margin-bottom:4rem;
position:relative;z-index:1;
}
.compare-table table{width:100%;border-collapse:collapse;}
.compare-table th{
background:var(–bg2);padding:1rem 1.2rem;
font-size:.82rem;font-weight:700;color:var(–text2);
font-family:var(–font-mono);text-align:center;
border-bottom:1px solid var(–border);
}
.compare-table th:first-child{text-align:right;}
.compare-table td{
padding:.9rem 1.2rem;font-size:.85rem;
border-bottom:1px solid var(–border);text-align:center;
color:var(–text2);
}
.compare-table td:first-child{text-align:right;font-weight:600;color:var(–text);}
.compare-table tr:last-child td{border-bottom:none;}
.compare-table tr:hover td{background:var(–card2);}
.check{color:#4ade80;font-size:1rem;}
.cross{color:#f87171;font-size:1rem;}
.partial{color:#fbbf24;font-size:1rem;}

/* SEARCH OVERLAY */
.search-overlay{position:fixed;inset:0;background:rgba(6,6,14,.97);z-index:2000;display:flex;align-items:flex-start;justify-content:center;padding-top:15vh;opacity:0;pointer-events:none;transition:opacity .3s;}
.search-overlay.open{opacity:1;pointer-events:all;}
.search-box{width:100%;max-width:680px;padding:0 2rem;}
.search-wrap{display:flex;align-items:center;background:var(–card);border:1px solid var(–border2);border-radius:14px;padding:.9rem 1.4rem;gap:1rem;}
.search-wrap:focus-within{border-color:var(–accent);}
#s-input{flex:1;background:transparent;border:none;color:var(–text);font-family:var(–font-ar);font-size:1.15rem;outline:none;text-align:right;}
.s-hint{font-family:var(–font-mono);font-size:.73rem;color:var(–text3);margin-top:.9rem;text-align:center;}

/* FOOTER */
footer{background:var(–bg2);border-top:1px solid var(–border);padding:4rem 0 2rem;margin-top:2rem;position:relative;z-index:1;}
.footer-grid{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:3rem;margin-bottom:3rem;}
.f-brand p{font-size:.85rem;color:var(–text2);margin:1rem 0 1.4rem;font-weight:300;line-height:1.75;}
.social-row{display:flex;gap:.65rem;}
.f-col h4{font-size:.88rem;font-weight:700;margin-bottom:1.2rem;color:var(–text);}
.f-links{list-style:none;display:flex;flex-direction:column;gap:.55rem;}
.f-links a{font-size:.83rem;color:var(–text2);text-decoration:none;transition:color .2s;font-weight:300;}
.f-links a:hover{color:var(–accent);}
.footer-bottom{padding-top:2rem;border-top:1px solid var(–border);display:flex;justify-content:space-between;align-items:center;font-size:.78rem;color:var(–text3);font-family:var(–font-mono);}

/* ANIMATIONS */
@keyframes fadeUp{from{opacity:0;transform:translateY(22px);}to{opacity:1;transform:translateY(0);}}
.fade-up{opacity:0;transform:translateY(22px);transition:opacity .6s ease,transform .6s ease;}
.fade-up.visible{opacity:1;transform:translateY(0);}

/* RESPONSIVE */
@media(max-width:1100px){
.tools-grid{grid-template-columns:repeat(2,1fr);}
.tool-card-wide{grid-column:span 2;}
.footer-grid{grid-template-columns:1fr 1fr;}
}
@media(max-width:768px){
.nav-links{display:none;}.hamburger{display:flex;}
.tools-grid{grid-template-columns:1fr;}
.tool-card-wide{grid-column:span 1;grid-template-columns:1fr;}
.tool-wide-right{align-items:flex-start;}
.footer-grid{grid-template-columns:1fr;gap:2rem;}
.footer-bottom{flex-direction:column;gap:.8rem;text-align:center;}
.compare-table{overflow-x:auto;}
}
</style>

</head>
