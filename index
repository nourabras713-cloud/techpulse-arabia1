<style>
:root {
  --bg:       #06060e;
  --bg2:      #0b0b16;
  --bg3:      #0f0f1c;
  --card:     #111120;
  --card2:    #16162a;
  --accent:   #00e5ff;
  --accent2:  #ff4d6d;
  --accent3:  #7b2fff;
  --gold:     #f5c518;
  --text:     #eeeef5;
  --text2:    #8888aa;
  --text3:    #44445a;
  --border:   #1e1e36;
  --border2:  #2a2a48;
  --font-ar:  'Cairo', 'Tajawal', sans-serif;
  --font-mono:'IBM Plex Mono', monospace;
  --r:        16px;
  --shadow:   0 8px 40px rgba(0,0,0,0.6);
  --glow:     0 0 60px rgba(0,229,255,0.12);
}

*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  background:var(--bg);
  color:var(--text);
  font-family:var(--font-ar);
  line-height:1.75;
  overflow-x:hidden;
}

/* SCROLLBAR */
::-webkit-scrollbar{width:3px;}
::-webkit-scrollbar-track{background:var(--bg);}
::-webkit-scrollbar-thumb{background:var(--accent);border-radius:2px;}

/* BACKGROUND GRID */
.bg-grid{
  position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:
    linear-gradient(rgba(0,229,255,0.025) 1px,transparent 1px),
    linear-gradient(90deg,rgba(0,229,255,0.025) 1px,transparent 1px);
  background-size:72px 72px;
}
.bg-orb{
  position:fixed;pointer-events:none;z-index:0;border-radius:50%;filter:blur(100px);
}
.bg-orb1{width:600px;height:600px;background:rgba(0,229,255,0.05);top:-200px;right:-200px;}
.bg-orb2{width:500px;height:500px;background:rgba(123,47,255,0.05);bottom:-200px;left:-200px;}

/* ═══ NAVBAR ═══ */
nav{
  position:fixed;top:0;width:100%;z-index:1000;
  padding:0 2rem;
  background:rgba(6,6,14,0.82);
  backdrop-filter:blur(24px);
  border-bottom:1px solid var(--border);
}
.nav-inner{
  max-width:1360px;margin:0 auto;
  display:flex;align-items:center;justify-content:space-between;
  height:68px;
}
.logo{display:flex;align-items:center;gap:.8rem;text-decoration:none;}
.logo-mark{
  width:42px;height:42px;border-radius:12px;
  background:linear-gradient(135deg,var(--accent),var(--accent3));
  display:flex;align-items:center;justify-content:center;
  font-family:var(--font-mono);font-weight:700;font-size:.95rem;color:#000;
  box-shadow:0 0 20px rgba(0,229,255,0.35);
}
.logo-text{line-height:1.15;}
.logo-en{font-family:var(--font-mono);font-size:.95rem;font-weight:700;color:var(--accent);}
.logo-ar{font-size:.68rem;color:var(--text3);font-weight:300;}
.nav-links{display:flex;gap:.1rem;list-style:none;}
.nav-links a{
  display:block;padding:.45rem .9rem;color:var(--text2);
  text-decoration:none;font-size:.88rem;border-radius:8px;
  transition:all .2s;font-weight:500;
}
.nav-links a:hover,.nav-links a.active{color:var(--accent);background:rgba(0,229,255,0.07);}
.nav-actions{display:flex;align-items:center;gap:.6rem;}
.btn-icon{
  width:38px;height:38px;border:1px solid var(--border);border-radius:9px;
  background:transparent;color:var(--text2);cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  transition:all .2s;font-size:.95rem;text-decoration:none;
}
.btn-icon:hover{border-color:var(--accent);color:var(--accent);}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:5px;}
.hamburger span{width:22px;height:2px;background:var(--text2);border-radius:2px;transition:all .3s;}

/* ═══ HERO ═══ */
.hero{
  min-height:100vh;display:flex;flex-direction:column;
  justify-content:center;align-items:center;text-align:center;
  padding:100px 2rem 5rem;position:relative;overflow:hidden;
}
.hero-glow{
  position:absolute;width:900px;height:900px;
  background:radial-gradient(circle,rgba(0,229,255,0.06) 0%,transparent 65%);
  top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none;
}
.hero-badge{
  display:inline-flex;align-items:center;gap:.5rem;
  padding:.4rem 1.1rem;border:1px solid rgba(0,229,255,0.25);
  border-radius:50px;font-size:.78rem;color:var(--accent);
  font-family:var(--font-mono);margin-bottom:2rem;
  background:rgba(0,229,255,0.04);
  animation:fadeUp .8s ease both;
}
.pulse-dot{
  width:7px;height:7px;border-radius:50%;
  background:var(--accent);animation:pulse 2s infinite;
}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.3;transform:scale(.7);}}
.hero h1{
  font-size:clamp(2.8rem,6.5vw,5.5rem);
  font-weight:900;line-height:1.08;
  margin-bottom:1.5rem;
  animation:fadeUp .8s .1s ease both;
}
.hero h1 .l1{display:block;color:var(--text);}
.hero h1 .l2{
  display:block;
  background:linear-gradient(120deg,var(--accent) 0%,var(--accent3) 60%,var(--accent2) 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
}
.hero-sub{
  font-size:1.12rem;color:var(--text2);max-width:580px;
  margin:0 auto 2.5rem;font-weight:300;
  animation:fadeUp .8s .2s ease both;
}
.hero-cta{
  display:flex;gap:1rem;flex-wrap:wrap;justify-content:center;
  animation:fadeUp .8s .3s ease both;
}
.btn-primary{
  padding:.85rem 2rem;
  background:linear-gradient(135deg,var(--accent),#007acc);
  color:#000;border:none;border-radius:11px;
  font-family:var(--font-ar);font-weight:700;font-size:1rem;
  cursor:pointer;text-decoration:none;
  display:inline-flex;align-items:center;gap:.5rem;
  transition:all .3s;box-shadow:0 0 30px rgba(0,229,255,0.3);
}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 0 50px rgba(0,229,255,0.5);}
.btn-outline{
  padding:.85rem 2rem;background:transparent;
  color:var(--text);border:1px solid var(--border2);
  border-radius:11px;font-family:var(--font-ar);
  font-weight:600;font-size:1rem;cursor:pointer;text-decoration:none;
  transition:all .3s;
}
.btn-outline:hover{border-color:var(--accent);color:var(--accent);}
.hero-stats{
  display:flex;gap:3.5rem;margin-top:4rem;padding-top:3rem;
  border-top:1px solid var(--border);
  animation:fadeUp .8s .4s ease both;
}
.stat{text-align:center;}
.stat-n{
  font-family:var(--font-mono);font-size:1.9rem;font-weight:700;
  color:var(--accent);display:block;
}
.stat-l{font-size:.78rem;color:var(--text3);margin-top:.2rem;}

/* ═══ TICKER ═══ */
.ticker{
  background:var(--bg2);padding:.7rem 0;overflow:hidden;
  border-top:1px solid var(--border);border-bottom:1px solid var(--border);
  position:relative;z-index:1;
}
.ticker-track{display:flex;gap:2.5rem;animation:ticker 35s linear infinite;white-space:nowrap;}
.ticker-item{
  display:flex;align-items:center;gap:.5rem;flex-shrink:0;
  font-size:.82rem;color:var(--text2);font-family:var(--font-mono);
}
.ticker-item span:first-child{color:var(--accent);}
@keyframes ticker{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}

/* ═══ AD UNIT ═══ */
.ad-wrap{padding:1.5rem 0;position:relative;z-index:1;}
.ad-unit{
  background:var(--bg2);border:1px dashed var(--border2);
  border-radius:var(--r);display:flex;align-items:center;
  justify-content:center;color:var(--text3);
  font-size:.75rem;font-family:var(--font-mono);
  text-align:center;padding:1rem;
}
.ad-banner{min-height:90px;width:100%;}
.ad-square{min-height:250px;width:100%;}
.ad-unit small{display:block;font-size:.62rem;margin-bottom:.3rem;color:var(--text3);}

/* ═══ CONTAINER / SECTIONS ═══ */
.container{max-width:1360px;margin:0 auto;padding:0 2rem;}
section{position:relative;z-index:1;}
.section-pad{padding:5rem 0;}
.section-head{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:2.5rem;
}
.section-label{display:flex;align-items:center;gap:.75rem;}
.section-label h2{font-size:1.55rem;font-weight:700;}
.tag-badge{
  font-family:var(--font-mono);font-size:.68rem;
  padding:.2rem .6rem;border:1px solid var(--accent);
  border-radius:5px;color:var(--accent);letter-spacing:.5px;
}
.link-all{
  font-size:.82rem;color:var(--accent);
  text-decoration:none;font-family:var(--font-mono);
  border-bottom:1px solid transparent;transition:border-color .2s;
}
.link-all:hover{border-color:var(--accent);}

/* ═══ FEATURED GRID ═══ */
.featured-grid{
  display:grid;
  grid-template-columns:1.65fr 1fr;
  gap:1.25rem;
}
.featured-side{display:flex;flex-direction:column;gap:1rem;}

/* ═══ ARTICLE CARD (big) ═══ */
.card{
  background:var(--card);border:1px solid var(--border);
  border-radius:var(--r);overflow:hidden;
  text-decoration:none;color:inherit;
  transition:all .3s;display:flex;flex-direction:column;cursor:pointer;
}
.card:hover{
  border-color:rgba(0,229,255,0.28);
  transform:translateY(-4px);
  box-shadow:var(--shadow),var(--glow);
}
.card-img{
  height:260px;
  background:linear-gradient(135deg,#0a0a20 0%,#12123a 50%,#080820 100%);
  display:flex;align-items:center;justify-content:center;
  position:relative;overflow:hidden;
}
.card-img-sm{height:170px;}
.card-emoji{font-size:3.2rem;filter:drop-shadow(0 0 24px rgba(0,229,255,.4));position:relative;z-index:1;}
.card-img::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(to bottom,transparent 50%,rgba(17,17,32,0.85) 100%);
}
.cat-tag{
  position:absolute;top:1rem;right:1rem;z-index:2;
  font-size:.68rem;font-family:var(--font-mono);font-weight:700;
  padding:.28rem .65rem;border-radius:6px;
}
.c-ai{background:rgba(123,47,255,.9);color:#ddd0ff;}
.c-web{background:rgba(0,229,255,.9);color:#000;}
.c-mob{background:rgba(255,77,109,.9);color:#fff;}
.c-sec{background:rgba(239,68,68,.9);color:#fff;}
.c-tools{background:rgba(34,197,94,.9);color:#000;}
.c-cloud{background:rgba(56,189,248,.9);color:#000;}

.card-body{padding:1.4rem;flex:1;display:flex;flex-direction:column;}
.card-meta{
  display:flex;align-items:center;gap:.9rem;
  font-size:.73rem;color:var(--text3);
  font-family:var(--font-mono);margin-bottom:.7rem;flex-wrap:wrap;
}
.card-title{
  font-size:1.18rem;font-weight:700;line-height:1.42;
  margin-bottom:.7rem;color:var(--text);
}
.card-title-sm{font-size:1rem;}
.card-excerpt{font-size:.88rem;color:var(--text2);line-height:1.65;flex:1;font-weight:300;}
.card-foot{
  display:flex;align-items:center;justify-content:space-between;
  margin-top:1.2rem;padding-top:1rem;border-top:1px solid var(--border);
}
.author{display:flex;align-items:center;gap:.55rem;}
.ava{
  width:30px;height:30px;border-radius:50%;
  background:linear-gradient(135deg,var(--accent),var(--accent3));
  display:flex;align-items:center;justify-content:center;
  font-size:.72rem;font-weight:700;color:#000;
}
.author-name{font-size:.78rem;color:var(--text2);}
.read-t{font-size:.72rem;color:var(--text3);font-family:var(--font-mono);}

/* ═══ ROW CARD (small side) ═══ */
.card-row{
  background:var(--card);border:1px solid var(--border);
  border-radius:13px;padding:1.15rem;
  text-decoration:none;color:inherit;
  display:flex;gap:.9rem;transition:all .3s;cursor:pointer;align-items:flex-start;
}
.card-row:hover{border-color:rgba(0,229,255,.28);background:var(--card2);}
.row-ico{
  width:48px;height:48px;border-radius:10px;flex-shrink:0;
  background:linear-gradient(135deg,#0f0f22,#1a1a3a);
  display:flex;align-items:center;justify-content:center;font-size:1.4rem;
}
.row-c{flex:1;}
.row-title{font-size:.92rem;font-weight:600;line-height:1.4;margin-bottom:.35rem;}
.row-meta{font-size:.72rem;color:var(--text3);font-family:var(--font-mono);}

/* ═══ CATEGORIES ═══ */
.cats-grid{
  display:grid;
  grid-template-columns:repeat(6,1fr);
  gap:1rem;
}
.cat-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:14px;padding:1.6rem 1rem;text-align:center;
  cursor:pointer;transition:all .3s;text-decoration:none;color:inherit;
}
.cat-card:hover{
  border-color:var(--accent);background:var(--card2);
  transform:translateY(-4px);box-shadow:0 12px 40px rgba(0,0,0,.4);
}
.cat-ico{font-size:2rem;margin-bottom:.7rem;display:block;}
.cat-name{font-size:.9rem;font-weight:600;margin-bottom:.2rem;}
.cat-cnt{font-size:.7rem;color:var(--text3);font-family:var(--font-mono);}

/* ═══ MAIN GRID (articles + sidebar) ═══ */
.main-grid{display:grid;grid-template-columns:1fr 300px;gap:2rem;}
.articles-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.2rem;}

/* ═══ SIDEBAR ═══ */
.sidebar{display:flex;flex-direction:column;gap:1.5rem;}
.widget{
  background:var(--card);border:1px solid var(--border);
  border-radius:14px;padding:1.4rem;
}
.widget-title{
  font-size:.88rem;font-weight:700;margin-bottom:1.2rem;
  display:flex;align-items:center;gap:.5rem;
}
.widget-title::before{
  content:'';width:3px;height:15px;
  background:var(--accent);border-radius:2px;
}
.trend-list{display:flex;flex-direction:column;gap:.7rem;}
.trend-item{
  display:flex;align-items:flex-start;gap:.7rem;
  padding-bottom:.7rem;border-bottom:1px solid var(--border);
  cursor:pointer;text-decoration:none;color:inherit;transition:color .2s;
}
.trend-item:last-child{border-bottom:none;padding-bottom:0;}
.trend-item:hover .t-ti{color:var(--accent);}
.t-n{font-family:var(--font-mono);font-size:1.1rem;font-weight:700;color:var(--border2);line-height:1;min-width:22px;}
.t-ti{font-size:.83rem;line-height:1.4;font-weight:500;}
.t-m{font-size:.7rem;color:var(--text3);font-family:var(--font-mono);margin-top:.2rem;}

.newsletter-w{background:linear-gradient(135deg,rgba(0,229,255,.07),rgba(123,47,255,.07));border-color:rgba(0,229,255,.18);}
.newsletter-w p{font-size:.83rem;color:var(--text2);margin-bottom:.9rem;font-weight:300;}
.inp-group{display:flex;flex-direction:column;gap:.45rem;}
.inp-group input{
  width:100%;padding:.65rem .9rem;
  background:var(--bg);border:1px solid var(--border);
  border-radius:8px;color:var(--text);
  font-family:var(--font-ar);font-size:.88rem;
  outline:none;transition:border-color .2s;text-align:right;
}
.inp-group input:focus{border-color:var(--accent);}
.inp-group button{
  padding:.65rem;
  background:linear-gradient(135deg,var(--accent),#007acc);
  border:none;border-radius:8px;color:#000;
  font-family:var(--font-ar);font-weight:700;cursor:pointer;transition:opacity .2s;
}
.inp-group button:hover{opacity:.85;}
.tags-cloud{display:flex;flex-wrap:wrap;gap:.45rem;}
.tag-pill{
  padding:.28rem .7rem;border:1px solid var(--border);
  border-radius:50px;font-size:.73rem;color:var(--text2);
  cursor:pointer;transition:all .2s;text-decoration:none;
}
.tag-pill:hover{border-color:var(--accent);color:var(--accent);background:rgba(0,229,255,.05);}

/* ═══ TUTORIALS ═══ */
.tuts-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem;}
.tut-card{
  background:var(--card);border:1px solid var(--border);
  border-radius:14px;padding:1.5rem;cursor:pointer;
  transition:all .3s;position:relative;overflow:hidden;
  text-decoration:none;color:inherit;
}
.tut-card::before{
  content:'';position:absolute;top:-30px;right:-30px;
  width:100px;height:100px;border-radius:50%;
  background:radial-gradient(circle,rgba(0,229,255,.08),transparent);
}
.tut-card:hover{border-color:rgba(0,229,255,.28);transform:translateY(-3px);box-shadow:var(--shadow);}
.tut-level{
  font-size:.68rem;font-family:var(--font-mono);
  padding:.2rem .6rem;border-radius:4px;
  margin-bottom:1rem;display:inline-block;
}
.lv-b{background:rgba(34,197,94,.12);color:#4ade80;border:1px solid rgba(34,197,94,.25);}
.lv-m{background:rgba(251,191,36,.12);color:#fbbf24;border:1px solid rgba(251,191,36,.25);}
.lv-a{background:rgba(239,68,68,.12);color:#f87171;border:1px solid rgba(239,68,68,.25);}
.tut-ico{font-size:2rem;margin-bottom:.7rem;display:block;}
.tut-title{font-size:1rem;font-weight:700;margin-bottom:.45rem;}
.tut-desc{font-size:.83rem;color:var(--text2);line-height:1.55;font-weight:300;}
.tut-foot{
  display:flex;justify-content:space-between;
  margin-top:1.2rem;padding-top:1rem;border-top:1px solid var(--border);
  font-size:.72rem;color:var(--text3);font-family:var(--font-mono);
}

/* ═══ FOOTER ═══ */
footer{
  background:var(--bg2);border-top:1px solid var(--border);
  padding:4rem 0 2rem;margin-top:4rem;position:relative;z-index:1;
}
.footer-grid{
  display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;
  gap:3rem;margin-bottom:3rem;
}
.f-brand p{font-size:.85rem;color:var(--text2);margin:1rem 0 1.4rem;font-weight:300;line-height:1.75;}
.social-row{display:flex;gap:.65rem;}
.f-col h4{font-size:.88rem;font-weight:700;margin-bottom:1.2rem;color:var(--text);}
.f-links{list-style:none;display:flex;flex-direction:column;gap:.55rem;}
.f-links a{font-size:.83rem;color:var(--text2);text-decoration:none;transition:color .2s;font-weight:300;}
.f-links a:hover{color:var(--accent);}
.footer-bottom{
  padding-top:2rem;border-top:1px solid var(--border);
  display:flex;justify-content:space-between;align-items:center;
  font-size:.78rem;color:var(--text3);font-family:var(--font-mono);
}

/* ═══ SEARCH OVERLAY ═══ */
.search-overlay{
  position:fixed;inset:0;background:rgba(6,6,14,.97);
  z-index:2000;display:flex;align-items:flex-start;
  justify-content:center;padding-top:15vh;
  opacity:0;pointer-events:none;transition:opacity .3s;
}
.search-overlay.open{opacity:1;pointer-events:all;}
.search-box{width:100%;max-width:680px;padding:0 2rem;}
.search-wrap{
  display:flex;align-items:center;
  background:var(--card);border:1px solid var(--border2);
  border-radius:14px;padding:.9rem 1.4rem;gap:1rem;
}
.search-wrap:focus-within{border-color:var(--accent);}
#s-input{
  flex:1;background:transparent;border:none;
  color:var(--text);font-family:var(--font-ar);font-size:1.15rem;
  outline:none;text-align:right;
}
.s-hint{
  font-family:var(--font-mono);font-size:.73rem;
  color:var(--text3);margin-top:.9rem;text-align:center;
}

/* ═══ MOBILE NAV ═══ */
.mobile-nav{
  display:none;flex-direction:column;
  position:absolute;top:68px;left:0;right:0;
  background:var(--bg2);border-bottom:1px solid var(--border);
  padding:1rem 2rem;z-index:999;
}
.mobile-nav a{
  display:block;padding:.6rem 0;color:var(--text2);
